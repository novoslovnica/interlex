datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/auth"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER) // Роль по умолчанию
  accounts      Account[]
  sessions      Session[]

  permissions   FeaturePermission[]
  settings      UserSettings?
  collections   UserWordCollection[]
  flashcardProgress FlashcardProgress[]
  apiKeys       ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FeaturePermission {
  id         String   @id @default(cuid())
  userId     String
  featureKey String   // Идентификатор фичи, например: "dictionary_create", "users_delete"
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Уникальный индекс, чтобы один юзер не мог получить одну фичу дважды
  @@unique([userId, featureKey])
  @@map("feature_permissions")
}

enum ScriptPreference {
  CYRILLIC
  LATIN
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model UserSettings {
  id               String           @id @default(cuid())
  userId           String           @unique
  script           ScriptPreference @default(CYRILLIC)
  theme            ThemePreference  @default(SYSTEM)
  language         String           @default("isv")
  columnVisibility String?
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserWordCollection {
  id        String   @id @default(cuid())
  userId    String
  wordId    Int
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@map("user_word_collection")
}

// Replay protection for Telegram Credentials login (auth.config.ts). The
// HMAC hash Telegram sends is already a unique, tamper-evident value per
// login event (distinct auth_date + user data -> distinct hash), so it
// doubles as the nonce itself - no separate nonce needs to be minted.
// authorize() claims a hash via an insert (unique constraint violation =
// replay detected) rather than check-then-insert, so the claim is atomic
// under concurrent requests. Rows older than the 24h auth_date freshness
// window (already enforced by verifyTelegramAuth's caller) are opportunistically
// swept - a payload that old would already fail the freshness check, so
// keeping its hash around forever serves no purpose.
model TelegramAuthNonce {
  hash      String   @id
  authDate  Int
  usedAt    DateTime @default(now())

  @@map("telegram_auth_nonces")
}

// Per-user spaced-repetition state for the flashcard learning feature
// (lib/srs/sm2.ts - classic SM-2). wordId is a plain Int, not a real FK -
// same cross-database-reference convention as UserWordCollection.wordId
// above (Lexeme lives in interlex.db, never joined with auth.db in one
// query). One row per (user, word) the learner has started reviewing;
// words never studied have no row at all and are picked as "new" cards by
// lib/srs/fetchFlashcardSession.ts based on CEFR level instead.
model FlashcardProgress {
  id             String   @id @default(cuid())
  userId         String
  wordId         Int
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  nextReviewAt   DateTime @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@map("flashcard_progress")
}

// Self-serve API keys for the public read-only API (app/api/public/v1/**).
// Raw key format: "islx_<random>". Only the SHA-256 hash is ever stored -
// the raw key is shown to the user exactly once, at creation, and never
// again (same discipline as a password hash, not a reversible secret).
// Verification is hash-then-lookup via the unique index on keyHash, not a
// manual byte comparison in application code, so crypto.timingSafeEqual
// (used for the Telegram HMAC check in auth.config.ts) doesn't apply here -
// there's no secret-byte-by-byte comparison for a timing side channel to
// exploit, same model as GitHub/Stripe API keys.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  name         String
  keyPrefix    String                      // first ~12 chars incl. "islx_", shown in the UI so a user can tell keys apart without re-revealing them
  keyHash      String    @unique
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?                   // soft delete - revoked rows are kept, never hard-deleted

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
