generator client {
  provider = "prisma-client"
  output   = "./generated/corpus"
}

datasource db {
  provider = "sqlite"
}

model CorpusDocument {
  id            String         @id @default(uuid())
  slug          String         @unique // Immutable slug для связи между базами
  title         String
  author        String?
  rawText       String         // Полный текст для быстрого чтения/отображения
  language      String         @default("is") // Межславянский диалект/версия
  genre         String         @default("fiction") // Жанр/субкорпус: fiction, news, publicistic, social_media, encyclopedic
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  candidatesProcessed Boolean  @default(false) // Собраны ли слова-кандидаты

  // Метки происхождения для внешних источников (напр. краулер Вікипедии).
  // externalId — стабильный тег источника (напр. "iswiki:2034" = pageid на isv.wikipedia.org),
  // не меняется при переименовании страницы. Позволяет краулеру находить и
  // обновлять уже загруженный документ вместо создания дубликата при повторном запуске.
  sourceUrl        String?
  externalId       String?      @unique
  sourceRevisionId Int?         // ID ревизии источника (напр. MediaWiki revid) для обнаружения изменений без перезагрузки текста

  // Связи
  tokens        CorpusToken[]
  sentences     CorpusSentence[]
  segments      CorpusSegment[]
}

model CorpusSegment {
  id            String         @id @default(uuid())
  documentSlug  String
  position      Int            // Порядковый номер абзаца в документе
  rawText       String         // Полный текст абзаца

  document      CorpusDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)
  sentences     CorpusSentence[]

  @@index([documentSlug, position])
}

model CorpusSentence {
  id            String         @id @default(uuid())
  documentSlug  String
  segmentId     String         // Ссылка на родительский абзац
  position      Int            // Порядковый номер предложения в документе
  rawText       String         // Текст конкретного предложения для KWIC

  document      CorpusDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)
  segment       CorpusSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  tokens        CorpusToken[]
  dependencies  CorpusDependency[]

  @@index([documentSlug, position])
}

model CorpusToken {
  id            BigInt         @id @default(autoincrement()) // BigInt, так как токенов будут миллионы
  documentSlug  String
  sentenceId    String

  // Позиционирование
  tokenIndex    Int            // Индекс токена в пределах всего документа
  wordIndex     Int            // Индекс только слов (игнорируя знаки препинания) для N-грамм

  // Лингвистические метрики
  surfaceForm   String         // Слово в тексте как оно есть (н-р: "дому")
  lemma         String         // Базовая форма из морфологического движка ("дом")
  pos           String         // Part of Speech tag ("NOUN")
  feats         Json?          // Грамматические признаки: { gender: "masc", case: "dat" }

  // Связи
  document      CorpusDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)
  sentence      CorpusSentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  wordSlug      String?
  matchCount    Int               @default(1) // Количество омонимов (0 — не найдено, 1 — один вариант, >1 — омонимия)

  // Персистентная копия MorphoAnalysis.isPartialMatch (см. DbAnalyzer.matchByStemPrefix).
  // Без этого поля "жёлтый" (стем совпал, флексия — нет, matchCount=1) на
  // диске неотличим от настоящего "зелёного" (matchCount=1 от точного
  // совпадения формы) — оба раньше писались с одинаковым matchCount и без
  // этого флага. Добавлено вместе с CorpusCandidateProposal (план
  // автогенерации кандидатов из красных/жёлтых токенов, 2026-07-29) —
  // именно жёлтые тексты и нужно было научиться выбирать запросом.
  isPartialMatch Boolean          @default(false)

  // 'auto' | 'manual' — тот же паттерн, что у CorpusDependency.source: ручной
  // выбор омонима модератором (см. CorpusTokenCandidate) не должен
  // затираться повторным "Пересчитать POS-tagging" (см. reanalyze route).
  resolutionSource String         @default("auto")

  // Индексы для мгновенного поиска (B-Tree)
  @@index([lemma])
  @@index([pos])
  @@index([documentSlug, tokenIndex])
  // Для оконного self-join по совместной встречаемости слов (см.
  // lib/corpus/collocations/) — применено вручную скриптом
  // scripts/db/2026-07-24-add-corpus-token-wordindex-index.ts, а не через
  // `prisma migrate dev` (в corpus.db нет таблицы _prisma_migrations,
  // тот же класс проблемы, что и дрейф interlex.db, см. CLAUDE.md).
  @@index([documentSlug, wordIndex])

  @@index([wordSlug])

  dependencyAsHead CorpusDependency[] @relation("DependencyHead")
  dependencyAsDep  CorpusDependency?  @relation("DependencyDependent")
  candidates       CorpusTokenCandidate[]
}

// Полный набор кандидатов-омонимов на токен (план "разрешение омонимии",
// Фаза 1). До этого DbAnalyzer.analyzeWord отбрасывал все варианты кроме
// произвольного (DB-order) победителя, оставляя только CorpusToken.matchCount
// как голое число — разрешать омонимию было не из чего. Таблица создаётся
// вручную сырым SQL (scripts/db/2026-07-28-add-corpus-token-candidates.ts),
// не через `prisma migrate dev` — та же причина, что и у CorpusDependency/
// VerbGovernment выше (в corpus.db нет _prisma_migrations, см. CLAUDE.md).
// "id" объявлен как Int (реальная DDL — "INTEGER PRIMARY KEY AUTOINCREMENT",
// настоящий rowid-алиас SQLite), в отличие от CorpusToken.id, для которого
// id вычисляется приложением заранее (см. upsertDocument.ts).
model CorpusTokenCandidate {
  id        Int      @id @default(autoincrement())
  tokenId   BigInt
  wordSlug  String
  lemma     String
  pos       String
  feats     Json?
  flavor    String?
  score     Float    @default(0)
  source    String   @default("form_freq") // 'form_freq' | 'context_gov' | 'flavor' | 'synset' | 'manual'
  rank      Int      @default(0)
  createdAt DateTime @default(now())

  token CorpusToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
}

// Синтаксический разбор (Фаза 1 см. AGENTS.md "Syntax Parser"): одно ребро
// dependency-графа на зависимый токен — headTokenId null только у корня
// клаузы. relation хранит канонические имена Universal Dependencies
// (nsubj, obj, obl, amod, mark, advcl, conj, ...) — см. lib/corpus/syntax/.
// Таблица создаётся вручную сырым SQL (scripts/db/2026-07-27-add-corpus-syntax-tables.ts),
// не через `prisma migrate dev` — та же причина, что и у остальных индексов
// в corpus.db (нет _prisma_migrations, см. CLAUDE.md). "id" объявлен как
// BigInt для типизации (по аналогии с CorpusToken.id — рёбер будет
// столько же, сколько токенов), но реальная DDL использует
// "INTEGER PRIMARY KEY AUTOINCREMENT" — SQLite не считает "BIGINT PRIMARY KEY"
// алиасом rowid (проверено эмпирически), поэтому только буквальный
// "INTEGER PRIMARY KEY" даёт настоящий автоинкремент без ручной генерации id.
model CorpusDependency {
  id          BigInt   @id @default(autoincrement())
  sentenceId  String
  headTokenId BigInt?  // null только для root
  depTokenId  BigInt   @unique // у токена ровно одна голова — гарантия дерева
  relation    String   // канонический UD deprel: nsubj, obj, obl, amod, mark, advcl, conj, root, ...
  confidence  String   // 'rule' | 'heuristic' | 'unresolved' — по аналогии со светофором DbAnalyzer
  source      String   @default("auto") // 'auto' | 'manual' — ручные правки в админке не должны затираться реимпортом
  createdAt   DateTime @default(now())

  sentence  CorpusSentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  headToken CorpusToken?   @relation("DependencyHead", fields: [headTokenId], references: [id], onDelete: Cascade)
  depToken  CorpusToken    @relation("DependencyDependent", fields: [depTokenId], references: [id], onDelete: Cascade)

  @@index([sentenceId])
  @@index([headTokenId])
}

// План "автогенерация кандидатов из красных/жёлтых токенов" (см. обсуждение
// в AGENTS.md-соседнем чате 2026-07-29). Один ряд — одна гипотеза
// восстановления исходной словарной формы для группы токенов с одинаковой
// нормализованной словоформой (clusterKey). Токен может дать несколько
// гипотез (омонимичное окончание совпадает с разными классами основ) —
// поэтому уникальность не на clusterKey, а на четвёрке ниже; повторный
// прогон генерации обновляет только статистику (occurrenceCount/exampleTokenIds/
// lastSeenAt), никогда не трогая status — тот же приём "не затирать ручное",
// что и у CorpusToken.resolutionSource/CorpusDependency.source выше.
//
// Таблица живёт в corpus.db, а не в data.db: генерация — это full-scan по
// CorpusToken (corpus.db), а Candidate (data.db) создаётся только один раз
// на кластер при одобрении — тот самый нечастый случай, где cross-db связь
// оправданно хранится как обычный Int без FK (candidateId), по аналогии с
// CorpusToken.wordSlug/CorpusTokenCandidate.wordSlug, уже ссылающимися на
// Lexeme.slug из другой базы без реального FK.
model CorpusCandidateProposal {
  id                 Int      @id @default(autoincrement())

  clusterKey         String   // normalizeSurfaceForm(surfaceForm) — группирует все токены одного слова
  ruleSource         String   // 'red_reverse_lookup' | 'yellow_stem_sibling'
  guessedPos         String   // PosType: NOUN | ADJ | VERB
  guessedStemType    String   // endingsRegistry StemType / AdjStemType / 'verb_lpart'
  guessedGrammeme    String   // граммема совпавшего окончания (см. lib/grammar/grammemes.ts)
  guessedStem        String
  reconstructedForm  String   // предполагаемая словарная (цитатная) форма

  siblingWordSlug    String?  // для 'yellow_stem_sibling' — лексема, чей стем совпал (matchByStemPrefix)
  possibleEndingGap  Boolean  @default(false) // guessedStem совпал с стемом siblingWordSlug целиком — вероятно баг парадигмы, а не новое слово

  rank               Int      @default(0) // 0 = самое специфичное совпадение (самое длинное окончание) в рамках своего clusterKey

  occurrenceCount    Int      @default(1) // сколько токенов с этой словоформой сейчас matchCount=0 в корпусе — пересчитывается заново при каждом прогоне, не инкрементируется
  exampleTokenIds    Json     // до 5 CorpusToken.id для примера в UI — не растёт неограниченно
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  status             String   @default("pending") // pending | rejected | promoted | merged_into_existing
  resolutionNote     String?  // 'proper_noun' | 'typo' | 'foreign' | 'ending_gap' | 'other' — свободный текст модератора
  candidateId        Int?     // Candidate.id из data.db после промоушена (без реального FK, кросс-база)
  reviewedByEmail    String?
  reviewedAt         DateTime?

  @@unique([clusterKey, ruleSource, guessedStemType, guessedGrammeme])
  @@index([clusterKey])
  @@index([status, occurrenceCount])
}

// Управление падежом: какой падеж требует глагол (или частица-возвратность
// sę меняет управление, ср. "bojati sę" + gen). В отличие от предложного
// управления (lib/corpus/syntax/government.ts, PREPOSITION_GOVERNMENT —
// хардкод, стабилен) глагольное управление специфично для каждой лексемы
// и должно проверяться лингвистом перед вводом — таблица намеренно
// стартует пустой, заполняется через будущую админку (см. Фазу 5 плана),
// а не хардкодом с непроверенными фактами.
model VerbGovernment {
  id           Int      @id @default(autoincrement())
  verbLemma    String
  reflexive    Boolean  @default(false) // sę меняет управление у части глаголов
  requiredCase String   // GrammaticalCase: nom/acc/gen/dat/loc/ins/voc
  role         String   @default("obj") // UD deprel: obj | iobj | obl
  priority     Int      @default(0) // порядок предпочтения при нескольких допустимых падежах
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([verbLemma, requiredCase, reflexive])
  @@index([verbLemma])
}

// prisma/analytics.schema

model WordFormPriority {
  id          String   @id @default(uuid())

  /// Исходная словоформа в нижнем регистре (напр. "domu", "domom").
  /// Служит точкой входа для O(1) поиска в рантайме.
  surfaceForm String   @unique

  /// Компактный денормализованный JSON-массив вариантов омонимии.
  /// Строгая валидированная структура элементов внутри массива:
  /// [{ "slug": "dom-noun-m", "pos": "NOUN", "case": "loc", "freq": 1520 }]
  distributions Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Индекс для форсирования мгновенной выборки текстовых ключей
  @@index([surfaceForm])
}

// Браузер устойчивых словосочетаний/n-грамм (roadmap #44, план
// groovy-soaring-wall). N-generic: одна таблица на все размеры (2..5),
// а не отдельные колонки/таблицы под каждый N — расширение диапазона
// размеров в lib/corpus/collocations/computeNgrams.ts — это правка
// конфига (NGRAM_SIZES), а не миграция схемы. slugs/lemmas — упорядоченные
// JSON-массивы длины n (в SQLite нет нативного array-типа). displayText —
// денормализованный текст фразы для дешёвого LIKE-поиска по слову без
// отдельной junction-таблицы (см. план — такая таблица для "похожие
// n-граммы этого слова" на /words/[id] осознанно не строится сейчас).
// Таблица создаётся вручную сырым SQL (scripts/db/2026-08-15-add-corpus-ngrams.ts),
// не через `prisma migrate dev` — та же причина, что и у остальных таблиц
// corpus.db (нет _prisma_migrations, см. CLAUDE.md). Пересчитывается
// полностью (delete+reinsert) при каждом запуске compute — здесь нет
// ручных модераторских правок, которые нужно защищать (в отличие от
// CorpusDependency.source/semantic_relations.source).
model CorpusNgram {
  id            Int      @id @default(autoincrement())
  n             Int                  // 2..5
  ngramKey      String               // slugs.join("␟") — канонический ключ для upsert
  slugs         Json                 // упорядоченный string[] Lexeme.slug, длина == n
  lemmas        Json                 // упорядоченный string[] для отображения (переживает удаление Lexeme)
  posPattern    String               // pos через "_", напр. "ADJ_NOUN" — для фильтра/отображения
  displayText   String               // фраза через пробел (латиница) — для LIKE-поиска
  frequency     Int                  // сырая частота смежных, внутри-предложенческих вхождений
  score         Float                // обобщённый PMI, единая метрика ранжирования для любого n
  logLikelihood Float?               // только для n=2
  dice          Float?               // только для n=2
  updatedAt     DateTime @updatedAt

  @@unique([n, ngramKey])
  @@index([n, frequency])
  @@index([n, score])
  @@index([displayText])
}

model CorpusConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("corpus_config")
}
