generator client {
  provider = "prisma-client"
  output   = "./generated/data"
}

datasource db {
  provider = "sqlite"
}

model Lexeme {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  slug            String           @unique
  external_id     Int?
  value           String?
  transcription   String?
  mainCategory    String?
  usageType       String?
  pos             String?
  aspect          String?
  transitivity    String?
  animacy         String?
  degree          String?
  pronType        String?
  numType         String?
  frequency       String?
  intelligibility String?
  addition        String?
  sameInLanguages String?
  etymology       String?

  proto           String?
  paradigm        String?
  protoStemClass  String?
  stemExtension   String?
  genesis         String?

  // ПОЛЯ ДЛЯ АВТОМАТИЧЕСКОЙ ГЕНЕРАЦИИ ПАРАДИГМ
  stem            String?
  secondaryStem   String?
  tertiaryStem    String?
  governsCase     Int?               // 2=GEN, 3=DAT, 4=ACC, 5=INS, 6=LOC. В будущем отдельная таблица для множественности
  gender          String?
  declension      Int?
  conjugation     Int?
  stressPosition  Int?               // Ударный слог от начала слова (0=первый). Для paradigm A, override penultimate.

  // Имя собственное / нарицательное
  properNoun      Boolean          @default(false)

  // Маркер аномалий флексий
  hasAnomalies    Boolean          @default(false)

  // Частотность на основе корпусных данных
  corpusFrequency       Int?
  corpusFrequencyPerMln Float?
  corpusRank            Int?
  corpusHapax           Boolean?

  // CEFR уровень и метрики распределения
  distributionD         Float?    // Juilland's D coefficient (0.01–1.0)
  usageScore            Float?    // usage_score = f_ipm × D × k_slav
  cefrLevel             String?   // 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'

  // Обратные связи Prisma
  meanings        Meaning[]
  lexemes_morphemes LexemeMorpheme[]
  anomalies       InflectionAnomaly[]
  lexemeAllophones   LexemeAllophone[]

  @@map("lexemes")
  @@index([slug])
  @@index([value])
}

model Candidate {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  value           String?
  isv             String?
  nsl             String?
  transcription   String?
  mainCategory    String?
  usageType       String?
  pos             String?
  aspect          String?
  transitivity    String?
  animacy         String?
  degree          String?
  pronType        String?
  numType         String?
  frequency       String?
  intelligibility String?
  addition        String?
  sameInLanguages String?
  etymology       String?
  proto           String?
  paradigm        String?
  protoStemClass  String?
  stemExtension   String?
  genesis         String?
  stem            String?
  secondaryStem   String?
  tertiaryStem    String?
  governsCase     Int?               // 2=GEN, 3=DAT, 4=ACC, 5=INS, 6=LOC
  gender          String?
  declension      Int?
  conjugation     Int?
  properNoun      Boolean          @default(false)
  hasAnomalies    Boolean          @default(false)
  promotedAt      DateTime?
  promotedToLexemeId Int?

  @@map("candidates")
  @@index([value])
  @@index([pos])
}

model Meaning {
  id       Int       @id @default(autoincrement())
  lexemeId   Int
  meaning  String?
  examples String?
  meaningVerified Int?
  meaningMessage  String?
  examplesVerified Int?
  examplesMessage  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Связь с таблицей лексем
  lexeme     Lexeme      @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  // Связь с синсетами RuWordNet
  synsets  MeaningSynset[]

  // Консолидированная семантическая сеть (2026-07-23), заменяет собой
  // Synonym/Antonym/Hypernym/.../Conclusion выше для новых данных — см.
  // AGENTS.md "Semantic Network" секцию. Старые 11 таблиц пока не удалены.
  semanticRelationsSource SemanticRelation[] @relation("SemanticRelationSource")
  semanticRelationsTarget SemanticRelation[] @relation("SemanticRelationTarget")

  // NSM-семантические праймы (2026-07-23) — если это значение является
  // экспонентом одного из ~64 семантических праймов
  primeExponents PrimeExponent[]

  // Консолидированная таблица переводов (2026-07-23), заменяет собой
  // en_word/en_mean...dsb_word/dsb_mean (удалены 2026-07-24, см. AGENTS.md).
  translations Translation[] @relation("TranslationMeaning")

  @@map("meanings")
  @@index([lexemeId])
}

model Morpheme {
  id    Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  value String?
  type  Int?    @default(0)
  stressPosition Int?               // Какой слог внутри морфемы ударный (0=первый, NULL=нейтральный)

  lexemes_morphemes LexemeMorpheme[]
  morphemeAllophones  MorphemeAllophone[]

  @@map("morphemes")
}

model LexemeMorpheme {
  id     Int  @id @default(autoincrement())
  lexemeId Int?
  morphemeId Int?

  lexeme   Lexeme? @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  morpheme   Morpheme? @relation(fields: [morphemeId], references: [id], onDelete: Cascade)

  @@map("lexemes_morphemes")
}

model AllophoneFlavor {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  label       String
  description String?
  lexemeAllophones   LexemeAllophone[]
  morphemeAllophones MorphemeAllophone[]
  endingAllophones   EndingAllophone[]
  @@map("allophone_flavors")
}

model LexemeAllophone {
  id        Int     @id @default(autoincrement())
  lexemeId  Int
  value     String
  flavorId  Int
  type      String  @default("standard")
  lexeme    Lexeme               @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  flavor    AllophoneFlavor      @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  @@unique([lexemeId, flavorId, type])
  @@map("lexeme_allophones")
  @@index([lexemeId])
  @@index([flavorId])
}

model MorphemeAllophone {
  id         Int     @id @default(autoincrement())
  morphemeId Int
  value      String
  flavorId   Int
  morpheme   Morpheme             @relation(fields: [morphemeId], references: [id], onDelete: Cascade)
  flavor     AllophoneFlavor      @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  @@unique([morphemeId, flavorId])
  @@map("morpheme_allophones")
  @@index([morphemeId])
  @@index([flavorId])
}

model EndingAllophone {
  id        Int     @id @default(autoincrement())
  stemType  String
  grammeme  String
  value     String
  flavorId  Int
  flavor    AllophoneFlavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  @@unique([stemType, grammeme, flavorId])
  @@map("ending_allophones")
  @@index([flavorId])
}

// Консолидированная таблица переводов (2026-07-23) — заменяет 18 таблиц
// (En...Dsb), удалённых 2026-07-24 (см. AGENTS.md), для всех данных.
//
// legacyWordId — архивная копия старого wordId. Тот столбец по схеме должен
// был указывать на Meaning, но по факту хранил Lexeme.id и уже расходился с
// реальной лексемой для 93% строк hsb/dsb (и части en/ru/mk/sr/bg) на живых
// данных — НЕ используется ни в одном запросе, только для истории/отката.
// "Все переводы лексемы X" получаются через meaningId -> Meaning.lexemeId.
model Translation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  language  String
  value     String?
  verified  Int?
  message   String?

  meaningId Int?
  meaning   Meaning? @relation("TranslationMeaning", fields: [meaningId], references: [id], onDelete: Cascade)

  legacyWordId Int?

  @@map("translations")
  @@index([meaningId])
  @@index([meaningId, verified])
  @@index([language, meaningId])
  @@index([language, verified])
}

// Карта основ → массив lexemeId омонимов (хеш-таблица для префиксного поиска омонимов)
// base — текстовая основа (уникальный ключ), wordIds — JSON-строка с массивом ID лексем-омонимов
model BaseHomonym {
  id      Int    @id @default(autoincrement())
  base    String @unique // Основа (н-р: "vod" для "voda")
  wordIds String          // JSON-массив: "[1, 5, 12]"

  @@map("base_homonyms")
  @@index([base])
}

// Таблица аномалий флексий
// Хранит нестандартные флексии для конкретных слов
// Значение флексии (н-р: "-ami", "-ov")
// Ключ-склейка граммемы (н-р: "PL_INST", "PL_GEN")
model InflectionAnomaly {
  id         Int    @id @default(autoincrement())
  lexemeId     Int
  inflection String
  grammeme   String

  lexeme       Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@map("inflection_anomalies")
  @@index([lexemeId])
  @@index([grammeme])
}

model ProtoSlavicWord {
  id        Int    @id @default(autoincrement())
  lemma     String
  body      String @default("")
  sourceUrl String @default("") @map("source_url")

  @@map("proto_slavic_words")
  @@index([lemma])
}

// Синсеты RuWordNet — смысловые группы слов
model Synset {
  synsetId         String           @id
  synsetExternalId String?          @map("synset_external_id")
  definition       String?
  domains          String?
  semanticCodes    String?          @map("semantic_codes")
  partOfSpeech     String?          @map("part_of_speech")

  meanings         MeaningSynset[]

  @@map("synsets")
}

// Связь значений с синсетами
model MeaningSynset {
  meaningId  Int
  synsetId   String
  source     String?
  confidence Float?

  meaning    Meaning  @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  synset     Synset   @relation(fields: [synsetId], references: [synsetId], onDelete: Cascade)

  @@id([meaningId, synsetId])
  @@map("meanings_synsets")
}

// Журнал изменений тезауруса (2026-07-25). Заменяет собой поле actionHistory,
// которое раньше дублировалось построчно в Lexeme/Candidate/Morpheme и во всех
// 18 языковых таблицах (в последних оно даже никогда не писалось — мёртвый вес).
// userId/userEmail хранятся как снимок, а не внешний ключ: User живёт в auth.db,
// в другой базе, а кросс-базовые связи в этом проекте намеренно не делаются —
// тот же принцип, что уже применялся к полю author в старом actionHistory.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actionId   String   // группирует несколько изменённых полей одного сохранения в одно действие
  entityType String   // 'Lexeme' | 'Morpheme' | 'Candidate' | ...
  entityId   Int
  field      String
  oldValue   String?
  newValue   String?
  userId     String?
  userEmail  String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([actionId])
  @@map("audit_logs")
}

// Консолидированная семантическая сеть (2026-07-23). Заменяет собой 11 таблиц
// Synonym/Antonym/Hypernym/Hyponym/Meronym/Holonym/RelatedWord/Cause/Effect/
// Premise/Conclusion — одна строка на факт, направление кодируется через
// sourceId/targetId, а не отдельными зеркальными строками (см. AGENTS.md
// "Semantic Network" — прошлые hypernyms/hyponyms и т.п. генерировались
// независимо и могли расходиться).
// relationType — обычная строка, не БД-enum, чтобы новые типы можно было
// добавлять как данные без миграции схемы.
// Симметричные типы (порядок неважен, при записи нормализуется sourceId=min,
// targetId=max): synonym, antonym, related, pos_synonym.
// Направленные типы (source=частное/зависимое, target=общее/управляющее):
// hypernymy (source=гипоним→target=гипероним), meronymy (source=часть→
// target=целое), causation (source=причина→target=следствие), entailment
// (source=предпосылка→target=заключение), instance_of (source=экземпляр→
// target=класс), derivation (source=база→target=производное).
// Старые 11 таблиц пока не удалены — удаление отложено до переноса админки
// (см. AGENTS.md, "деферред TODO").
model SemanticRelation {
  id           Int      @id @default(autoincrement())
  sourceId     Int
  targetId     Int
  relationType String   @map("relation_type")
  proximity    Float?
  source       String   @default("manual")
  createdAt    DateTime @default(now()) @map("created_at")

  sourceMeaning Meaning @relation("SemanticRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetMeaning Meaning @relation("SemanticRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, relationType])
  @@index([targetId, relationType])
  @@map("semantic_relations")
}

// NSM-семантические праймы (2026-07-23). Справочник ~64 универсальных
// неопределяемых смыслов (Goddard 2011 chart, см. AGENTS.md "Semantic
// Network" для точной цитаты и расхождения 64 vs широко цитируемых 65) —
// код праймов не меняется независимо от того, какие межславянские слова
// выбраны их экспонентами.
model SemanticPrime {
  code        String @id
  category    String?
  englishText String @map("english_text")
  sortOrder   Int    @map("sort_order")

  exponents PrimeExponent[]

  @@map("semantic_primes")
}

// Экспонент прайма — конкретное межславянское значение (Meaning), которое
// реализует данный прайм. Один прайм может иметь несколько аллолексов
// (разные поверхностные формы в разных грамматических контекстах — это
// заложено в саму теорию NSM, не ошибка), поэтому это join-таблица, а не
// прямой FK на SemanticPrime.
model PrimeExponent {
  id          Int     @id @default(autoincrement())
  primeCode   String  @map("prime_code")
  meaningId   Int
  isCanonical Boolean @default(true) @map("is_canonical")
  note        String?

  prime   SemanticPrime @relation(fields: [primeCode], references: [code], onDelete: Cascade)
  meaning Meaning       @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  @@unique([primeCode, meaningId])
  @@index([meaningId])
  @@map("prime_exponents")
}