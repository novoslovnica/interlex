generator client {
  provider = "prisma-client"
  output   = "./generated/library"
}

datasource db {
  provider = "sqlite"
}

model LibraryEntry {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  author      String?
  genre       String   @default("article")
  topic       String?
  flavor      String   @default("CORE")

body       String?
  bodyLength Int      @default(0)

  source          String?
  yearWritten     Int?
  yearTranslated  Int?
  translator      String?

  addedById   String?
  addedBy     String?

  verified    Boolean  @default(false)
  verifiedBy  String?

  corpusSlug  String?

  summary     String?
  coverImage  String?
  audioFile   String?
  videoUrls   String?
  views       Int      @default(0)

  isPublic    Boolean  @default(true)
  parentId    Int?
  parent      LibraryEntry?  @relation("CollectionChildren", fields: [parentId], references: [id])
  children    LibraryEntry[] @relation("CollectionChildren")

  // Агрегированная CEFR-оценка читабельности текста (roadmap п.42) - null,
  // пока не посчитана (см. lib/library/computeReadability.ts). score - средний
  // порядковый уровень токенов, распознанных DbAnalyzer'ом (1=A1..6=C2);
  // level - ближайший CEFR-бакет; coverage - доля токенов текста, для
  // которых удалось получить cefrLevel (низкое покрытие => оценке не стоит
  // доверять, см. UI-порог в lib/library/computeReadability.ts).
  readabilityScore    Float?
  readabilityLevel    String?
  readabilityCoverage Float?

  actionHistory String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Медиатека сообщества (roadmap п.82) - каталог ВНЕШНЕГО аудио/видео-
// контента на ISV (подкасты, YouTube-каналы), намеренно отдельная модель от
// LibraryEntry: LibraryEntry моделирует одно произведение (текст с телом,
// CEFR-читабельностью и т.п.), а тут - ссылка на внешний канал/шоу без
// собственного тела. v1: наполнение только модераторами, без публичных
// предложений (в отличие от WordSuggestion/ContentReport).
model MediaLibraryEntry {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  mediaType    String   // 'podcast' | 'youtube_channel' | 'video' | 'audio_track' | 'other'
  url          String
  platform     String?  // 'youtube' | 'spotify' | 'soundcloud' | 'apple_podcasts' | 'other'
  description  String?
  thumbnailUrl String?
  language     String?  // свободный текст, напр. "isv" или "isv+ru"

  addedById  String?
  addedBy    String?
  verified   Boolean @default(false)
  verifiedBy String?

  isPublic Boolean @default(true)
  views    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}